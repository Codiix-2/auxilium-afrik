# Keep custom themes and plugins
!/wp-content/themes/
!/wp-content/plugins/

# Ignore vendor inside themes/plugins if desired
wp-content/themes/*/vendor/
wp-content/plugins/*/vendor/

# Ignore node_modules inside themes/plugins
wp-content/themes/*/node_modules/
wp-content/plugins/*/node_modules/

# Keep mu-plugins
!/wp-content/mu-plugins/

